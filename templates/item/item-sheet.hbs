                  <label><span>Resource Loss</span><input name="system.features.9.resourceLoss" type="number" value="{{lookup (lookup system.features "9") "resourceLoss"}}" min="0" /></label>
                </div>
                <label><span>Placeable Area</span><input name="system.features.9.areaOfEffect" type="checkbox" {{#if (lookup (lookup system.features "9") "areaOfEffect")}}checked{{/if}} /></label>
                {{#if (lookup (lookup system.features "9") "areaOfEffect")}}<div class="magic-item-area-fields"><label><span>Shape</span><select name="system.features.9.areaShape"><option value="cone" {{#if (eq (lookup (lookup system.features "9") "areaShape") "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq (lookup (lookup system.features "9") "areaShape") "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq (lookup (lookup system.features "9") "areaShape") "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq (lookup (lookup system.features "9") "areaShape") "radius")}}selected{{/if}}>Radius</option></select></label><label><span>Area Color</span><input name="system.features.9.areaColor" type="color" value="{{lookup (lookup system.features "9") "areaColor"}}" /></label><label><span>Area Size</span><input name="system.features.9.areaSize" type="number" value="{{lookup (lookup system.features "9") "areaSize"}}" min="1" /></label></div>{{#if (eq (lookup (lookup system.features "9") "areaShape") "ray")}}<div class="magic-item-area-fields"><label><span>Ray Length</span><input name="system.features.9.areaRayLength" type="number" value="{{lookup (lookup system.features "9") "areaRayLength"}}" min="1" /></label><label><span>Ray Width</span><input name="system.features.9.areaRayWidth" type="number" value="{{lookup (lookup system.features "9") "areaRayWidth"}}" min="1" /></label></div>{{/if}}{{/if}}
              </div>
            </div>
          {{else}}
            <div class="profession-feature-summary">
              {{#each professionFeatureSummaries as |feature|}}
                <div class="profession-feature-summary-card">
                  <div class="profession-feature-summary-header">
                    <strong>Level {{feature.level}}</strong>
                    <span>{{feature.title}}</span>
                  </div>
                  {{#if feature.text}}<p>{{feature.text}}</p>{{/if}}
                  <div class="profession-feature-summary-resources">
                    <span>{{feature.actionTypeLabel}}</span>
                    <span>Gain {{feature.resourceGain}}</span>
                    <span>Use {{feature.resourceLoss}}</span>
                    {{#if feature.hasArea}}<span>{{feature.areaLabel}}</span>{{/if}}
                  </div>
                </div>
              {{else}}
                <div class="profession-feature-summary-card">No profession features configured.</div>
              {{/each}}
            </div>
          {{/if}}
        {{/if}}

        {{#if (and isEditMode (eq item.type "race"))}}
          <div class="race-movement-field"><label><span>Movement</span><input name="system.movement" type="number" value="{{system.movement}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label></div>
          <div class="race-language-editor">
            <div class="race-language-header">
              <label>Race Languages</label>
            </div>
            <div class="race-language-grid">
              {{#each languageOptions as |language|}}
                <label><input name="system.languages.{{language.key}}" type="checkbox" {{#if (lookup @root.system.languages language.key)}}checked{{/if}} {{#unless @root.isEditMode}}disabled{{/unless}} /> {{language.label}}</label>
              {{/each}}
            </div>
          </div>
          <div class="race-language-editor">
            <div class="profession-skill-choice-title-row">
              <label>Player Language Choices</label>
              <button type="button" data-add-race-language-choice>Add Choice</button>
            </div>
            <div class="profession-skill-choice-list">
              {{#each raceLanguageChoiceGroups as |group|}}
                <details class="profession-skill-choice-block" data-choice-type="race-language" data-choice-group-id="{{group.id}}">
                  <summary>
                    <span>{{group.label}}</span>
                    <button type="button" data-remove-race-language-choice data-choice-group-id="{{group.id}}">Remove</button>
                  </summary>
                  <div class="profession-skill-choice-body">
                    <label><span>Choice Name</span><input name="system.languageChoiceGroups.{{group.id}}.label" type="text" value="{{group.label}}" /></label>
                    <label><span>Choice Type</span><select name="system.languageChoiceGroups.{{group.id}}.mode">
                      <option value="any" {{#if group.isAny}}selected{{/if}}>Any Unknown Language</option>
                      <option value="specific" {{#if group.isSpecific}}selected{{/if}}>Specific Languages</option>
                    </select></label>
                    {{#if group.isSpecific}}
                      <div class="race-language-grid race-language-choice-grid">
                        {{#each group.languageOptions as |language|}}
                          <label><input name="system.languageChoiceGroups.{{../id}}.languages.{{language.key}}" type="checkbox" {{#if language.checked}}checked{{/if}} /> {{language.label}}</label>
                        {{/each}}
                      </div>
                    {{else}}
                      <p class="profession-skill-choice-empty">Player chooses from any language they do not already know.</p>
                    {{/if}}
                  </div>
                </details>
              {{else}}
                <p class="profession-skill-choice-empty">No player language choices configured.</p>
              {{/each}}
            </div>
          </div>
          <div class="feature-editor-group race-feature-editor-group">
            <label>Race Features</label>
            <div class="feature-level-editor race-feature-level-editor">
              <div class="race-feature-field-row">
                <label><span>Level 1</span><input name="system.features.1.title" type="text" value="{{lookup (lookup system.features "1") "title"}}" placeholder="Feature Title" {{#unless isEditMode}}disabled{{/unless}} /></label>
                <label><span>Uses / Day</span><input name="system.features.1.uses" type="number" value="{{lookup (lookup system.features "1") "uses"}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
              </div>
              <label><span>Action</span><select name="system.features.1.actionType">{{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq (lookup (lookup @root.system.features "1") "actionType") action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}</select></label>
              <textarea name="system.features.1.text" placeholder="Feature description" {{#unless isEditMode}}disabled{{/unless}}>{{lookup (lookup system.features "1") "text"}}</textarea>
              <label><span>Placeable Area</span><input name="system.features.1.areaOfEffect" type="checkbox" {{#if (lookup (lookup system.features "1") "areaOfEffect")}}checked{{/if}} /></label>
              {{#if (lookup (lookup system.features "1") "areaOfEffect")}}<div class="magic-item-area-fields"><label><span>Shape</span><select name="system.features.1.areaShape"><option value="cone" {{#if (eq (lookup (lookup system.features "1") "areaShape") "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq (lookup (lookup system.features "1") "areaShape") "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq (lookup (lookup system.features "1") "areaShape") "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq (lookup (lookup system.features "1") "areaShape") "radius")}}selected{{/if}}>Radius</option></select></label><label><span>Area Color</span><input name="system.features.1.areaColor" type="color" value="{{lookup (lookup system.features "1") "areaColor"}}" /></label><label><span>Area Size</span><input name="system.features.1.areaSize" type="number" value="{{lookup (lookup system.features "1") "areaSize"}}" min="1" /></label></div>{{#if (eq (lookup (lookup system.features "1") "areaShape") "ray")}}<div class="magic-item-area-fields"><label><span>Ray Length</span><input name="system.features.1.areaRayLength" type="number" value="{{lookup (lookup system.features "1") "areaRayLength"}}" min="1" /></label><label><span>Ray Width</span><input name="system.features.1.areaRayWidth" type="number" value="{{lookup (lookup system.features "1") "areaRayWidth"}}" min="1" /></label></div>{{/if}}{{/if}}
            </div>
            <div class="feature-level-editor race-feature-level-editor">
              <div class="race-feature-field-row">
                <label><span>Level 5</span><input name="system.features.5.title" type="text" value="{{lookup (lookup system.features "5") "title"}}" placeholder="Feature Title" {{#unless isEditMode}}disabled{{/unless}} /></label>
                <label><span>Uses / Day</span><input name="system.features.5.uses" type="number" value="{{lookup (lookup system.features "5") "uses"}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
              </div>
              <label><span>Action</span><select name="system.features.5.actionType">{{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq (lookup (lookup @root.system.features "5") "actionType") action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}</select></label>
              <textarea name="system.features.5.text" placeholder="Feature description" {{#unless isEditMode}}disabled{{/unless}}>{{lookup (lookup system.features "5") "text"}}</textarea>
              <label><span>Placeable Area</span><input name="system.features.5.areaOfEffect" type="checkbox" {{#if (lookup (lookup system.features "5") "areaOfEffect")}}checked{{/if}} /></label>
              {{#if (lookup (lookup system.features "5") "areaOfEffect")}}<div class="magic-item-area-fields"><label><span>Shape</span><select name="system.features.5.areaShape"><option value="cone" {{#if (eq (lookup (lookup system.features "5") "areaShape") "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq (lookup (lookup system.features "5") "areaShape") "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq (lookup (lookup system.features "5") "areaShape") "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq (lookup (lookup system.features "5") "areaShape") "radius")}}selected{{/if}}>Radius</option></select></label><label><span>Area Color</span><input name="system.features.5.areaColor" type="color" value="{{lookup (lookup system.features "5") "areaColor"}}" /></label><label><span>Area Size</span><input name="system.features.5.areaSize" type="number" value="{{lookup (lookup system.features "5") "areaSize"}}" min="1" /></label></div>{{#if (eq (lookup (lookup system.features "5") "areaShape") "ray")}}<div class="magic-item-area-fields"><label><span>Ray Length</span><input name="system.features.5.areaRayLength" type="number" value="{{lookup (lookup system.features "5") "areaRayLength"}}" min="1" /></label><label><span>Ray Width</span><input name="system.features.5.areaRayWidth" type="number" value="{{lookup (lookup system.features "5") "areaRayWidth"}}" min="1" /></label></div>{{/if}}{{/if}}
            </div>
            <div class="feature-level-editor race-feature-level-editor">
              <div class="race-feature-field-row">
                <label><span>Level 10</span><input name="system.features.10.title" type="text" value="{{lookup (lookup system.features "10") "title"}}" placeholder="Feature Title" {{#unless isEditMode}}disabled{{/unless}} /></label>
                <label><span>Uses / Day</span><input name="system.features.10.uses" type="number" value="{{lookup (lookup system.features "10") "uses"}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
              </div>
              <label><span>Action</span><select name="system.features.10.actionType">{{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq (lookup (lookup @root.system.features "10") "actionType") action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}</select></label>
              <textarea name="system.features.10.text" placeholder="Feature description" {{#unless isEditMode}}disabled{{/unless}}>{{lookup (lookup system.features "10") "text"}}</textarea>
              <label><span>Placeable Area</span><input name="system.features.10.areaOfEffect" type="checkbox" {{#if (lookup (lookup system.features "10") "areaOfEffect")}}checked{{/if}} /></label>
              {{#if (lookup (lookup system.features "10") "areaOfEffect")}}<div class="magic-item-area-fields"><label><span>Shape</span><select name="system.features.10.areaShape"><option value="cone" {{#if (eq (lookup (lookup system.features "10") "areaShape") "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq (lookup (lookup system.features "10") "areaShape") "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq (lookup (lookup system.features "10") "areaShape") "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq (lookup (lookup system.features "10") "areaShape") "radius")}}selected{{/if}}>Radius</option></select></label><label><span>Area Color</span><input name="system.features.10.areaColor" type="color" value="{{lookup (lookup system.features "10") "areaColor"}}" /></label><label><span>Area Size</span><input name="system.features.10.areaSize" type="number" value="{{lookup (lookup system.features "10") "areaSize"}}" min="1" /></label></div>{{#if (eq (lookup (lookup system.features "10") "areaShape") "ray")}}<div class="magic-item-area-fields"><label><span>Ray Length</span><input name="system.features.10.areaRayLength" type="number" value="{{lookup (lookup system.features "10") "areaRayLength"}}" min="1" /></label><label><span>Ray Width</span><input name="system.features.10.areaRayWidth" type="number" value="{{lookup (lookup system.features "10") "areaRayWidth"}}" min="1" /></label></div>{{/if}}{{/if}}
            </div>
            <div class="feature-level-editor race-feature-level-editor">
              <div class="race-feature-field-row">
                <label><span>Level 15</span><input name="system.features.15.title" type="text" value="{{lookup (lookup system.features "15") "title"}}" placeholder="Feature Title" {{#unless isEditMode}}disabled{{/unless}} /></label>
                <label><span>Uses / Day</span><input name="system.features.15.uses" type="number" value="{{lookup (lookup system.features "15") "uses"}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
              </div>
              <label><span>Action</span><select name="system.features.15.actionType">{{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq (lookup (lookup @root.system.features "15") "actionType") action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}</select></label>
              <textarea name="system.features.15.text" placeholder="Feature description" {{#unless isEditMode}}disabled{{/unless}}>{{lookup (lookup system.features "15") "text"}}</textarea>
              <label><span>Placeable Area</span><input name="system.features.15.areaOfEffect" type="checkbox" {{#if (lookup (lookup system.features "15") "areaOfEffect")}}checked{{/if}} /></label>
              {{#if (lookup (lookup system.features "15") "areaOfEffect")}}<div class="magic-item-area-fields"><label><span>Shape</span><select name="system.features.15.areaShape"><option value="cone" {{#if (eq (lookup (lookup system.features "15") "areaShape") "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq (lookup (lookup system.features "15") "areaShape") "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq (lookup (lookup system.features "15") "areaShape") "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq (lookup (lookup system.features "15") "areaShape") "radius")}}selected{{/if}}>Radius</option></select></label><label><span>Area Color</span><input name="system.features.15.areaColor" type="color" value="{{lookup (lookup system.features "15") "areaColor"}}" /></label><label><span>Area Size</span><input name="system.features.15.areaSize" type="number" value="{{lookup (lookup system.features "15") "areaSize"}}" min="1" /></label></div>{{#if (eq (lookup (lookup system.features "15") "areaShape") "ray")}}<div class="magic-item-area-fields"><label><span>Ray Length</span><input name="system.features.15.areaRayLength" type="number" value="{{lookup (lookup system.features "15") "areaRayLength"}}" min="1" /></label><label><span>Ray Width</span><input name="system.features.15.areaRayWidth" type="number" value="{{lookup (lookup system.features "15") "areaRayWidth"}}" min="1" /></label></div>{{/if}}{{/if}}
            </div>
          </div>
        {{/if}}
        {{#unless isEditMode}}
        {{#if (eq item.type "race")}}
          <div class="profession-feature-summary">
            {{#each raceFeatureSummaries as |feature|}}
              <div class="profession-feature-summary-card">
                <div class="profession-feature-summary-header">
                  <strong>Level {{feature.level}}</strong>
                  <span>{{feature.title}}</span>
                </div>
                {{#if feature.text}}<p>{{feature.text}}</p>{{/if}}
                <div class="profession-feature-summary-resources">
                  <span>{{feature.actionTypeLabel}}</span>
                  {{#if feature.hasUses}}<span>Uses / Day {{feature.uses}}</span>{{/if}}
                  {{#if feature.hasArea}}<span>{{feature.areaLabel}}</span>{{/if}}
                </div>
              </div>
            {{else}}
              <div class="profession-feature-summary-card">No race features configured.</div>
            {{/each}}
          </div>
        {{/if}}
        {{/unless}}
      {{/if}}

      {{#if (and isEditMode (or (eq item.type "spell") (eq item.type "gear")))}}
        <div class="flex-row">
          <label>Description</label>
        </div>
        <textarea name="system.description" {{#unless isEditMode}}disabled{{/unless}}>{{system.description}}</textarea>

        {{#if (eq item.type "spell")}}
          <div class="flex-row">
            <label>Empowerment Description</label>
          </div>
          <textarea name="system.empowermentDescription" {{#unless isEditMode}}disabled{{/unless}}>{{system.empowermentDescription}}</textarea>
          <div class="item-area-editor">
            <label><span>Placeable Area</span><input name="system.areaOfEffect" type="checkbox" {{#if system.areaOfEffect}}checked{{/if}} /></label>
            {{#if system.areaOfEffect}}
              <div class="magic-item-area-fields">
                <label><span>Shape</span><select name="system.areaShape"><option value="cone" {{#if (eq system.areaShape "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq system.areaShape "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq system.areaShape "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq system.areaShape "radius")}}selected{{/if}}>Radius</option></select></label>
                <label><span>Area Color</span><input name="system.areaColor" type="color" value="{{system.areaColor}}" /></label>
                <label><span>Area Size</span><input name="system.areaSize" type="number" value="{{system.areaSize}}" min="1" /></label>
              </div>
              {{#if (eq system.areaShape "ray")}}
                <div class="magic-item-area-fields">
                  <label><span>Ray Length</span><input name="system.areaRayLength" type="number" value="{{system.areaRayLength}}" min="1" /></label>
                  <label><span>Ray Width</span><input name="system.areaRayWidth" type="number" value="{{system.areaRayWidth}}" min="1" /></label>
                </div>
              {{/if}}
            {{/if}}
          </div>
        {{/if}}
      {{/if}}

      {{#if (or (eq item.type "armor") (eq item.type "gear") (eq item.type "weapon") (eq item.type "race") (eq item.type "profession") (eq item.type "spell") (eq item.type "talent") (eq item.type "trait") (eq item.type "npcAction"))}}
        <section class="item-effects-panel active-effects-display active-effect-drop-zone">
          <h3>Active Effects</h3>
          {{#if itemEffects.length}}
            {{#each itemEffects as |effect|}}
              <div class="active-effect-row" data-effect-id="{{effect.id}}" title="Right-click to remove">
                <img src="{{effect.img}}" alt="" />
                <span>{{effect.name}}</span>
                <span class="active-effect-type">{{effect.typeLabel}}</span>
                {{#if effect.disabled}}<span class="active-effect-disabled">Disabled</span>{{else}}<span>Active</span>{{/if}}
                <input class="active-effect-quantity" data-effect-id="{{effect.id}}" type="number" value="{{effect.quantity}}" min="0" aria-label="{{effect.name}} quantity" {{#unless ../isEditMode}}disabled{{/unless}} />
                <button type="button" class="remove-active-effect" data-effect-id="{{effect.id}}" title="Remove effect" aria-label="Remove {{effect.name}}" {{#unless ../isEditMode}}disabled{{/unless}}><i class="fas fa-trash"></i></button>
              </div>
            {{/each}}
          {{else}}
            <p>Drag an Active Effect here.</p>
          {{/if}}
          <button type="button" class="create-active-effect" {{#unless isEditMode}}disabled{{/unless}}>Create Effect</button>
        </section>
      {{/if}}
    </div>
  </section>
</form>
