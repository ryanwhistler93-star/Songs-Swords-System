<form class="d100-system item-sheet {{#unless isEditMode}}read-mode{{/unless}}" autocomplete="off">
  <header class="sheet-header">
    <img src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div>
      <h1><input name="name" type="text" value="{{item.name}}" placeholder="Item Name" {{#unless isEditMode}}disabled{{/unless}} /></h1>
      <div class="flex-row">
        <label>Type</label>
        <input name="type" type="text" value="{{item.type}}" readonly />
      </div>
    </div>
    {{#if (or (eq item.type "gear") (eq item.type "weapon") (eq item.type "armor") (eq item.type "profession") (eq item.type "race") (eq item.type "talent") (eq item.type "spell") (eq item.type "trait") (eq item.type "npcAction") (eq item.type "category") (eq item.type "weaponTechnique"))}}
      <div class="sheet-controls">
        <label class="edit-toggle">
          <input type="checkbox" data-edit-toggle {{#if isEditMode}}checked{{/if}} /> Edit Mode
        </label>
      </div>
    {{/if}}
  </header>

  <section class="sheet-body">
    <div class="tab active" data-group="primary" data-tab="single">
      {{#unless isEditMode}}
        {{#if hasItemSummary}}
          <div class="item-sheet-summary">
            {{#each itemSummaryFields as |field|}}
              <div class="item-sheet-summary-card"><strong>{{field.label}}</strong><span>{{field.value}}</span></div>
            {{/each}}
          </div>
        {{/if}}
        {{#if system.description}}
          <section class="item-read-summary-text">
            <h3>Description</h3>
            <p>{{system.description}}</p>
          </section>
        {{/if}}
        {{#if system.empowermentDescription}}
          <section class="item-read-summary-text">
            <h3>Empowerment</h3>
            <p>{{system.empowermentDescription}}</p>
          </section>
        {{/if}}
      {{/unless}}

      {{#if (and isEditMode (eq item.type "talent"))}}
        <div class="talent-detail-fields">
          <label><span>Skill</span>
            <select name="system.skill" {{#unless isEditMode}}disabled{{/unless}}>
              <option value="">None</option>
              {{#each @root.skillOptions as |skill|}}
                <option value="{{skill.key}}" {{#if (eq @root.system.skill skill.key)}}selected{{/if}}>{{skill.label}}</option>
              {{/each}}
            </select>
          </label>
          <label><span>Tier</span>
            <select name="system.tier" {{#unless isEditMode}}disabled{{/unless}}>
              <option value="1" {{#if (eq system.tier "1")}}selected{{/if}}>1</option>
              <option value="2" {{#if (eq system.tier "2")}}selected{{/if}}>2</option>
              <option value="3" {{#if (eq system.tier "3")}}selected{{/if}}>3</option>
            </select>
          </label>
          <label><span>Uses / Day</span><input name="system.usesPerDay" type="number" value="{{system.usesPerDay}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
          <label><span>Action</span><select name="system.actionType">
            {{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq @root.system.actionType action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}
          </select></label>
        </div>
      {{/if}}

      {{#if (and isEditMode (eq item.type "trait"))}}
        <div class="profession-detail-fields">
          <label><span>Trait Point Cost</span><input name="system.traitPointCost" type="number" value="{{system.traitPointCost}}" min="0" /></label>
        </div>
      {{/if}}

      {{#if (and isEditMode (eq item.type "npcAction"))}}
        <div class="talent-detail-fields npc-action-detail-fields">
          <label><span>Hazard Action</span><input name="system.isHazardAction" type="checkbox" {{#if system.isHazardAction}}checked{{/if}} /></label>
          {{#if system.isHazardAction}}
            <label><span>Trigger</span><input name="system.trigger" type="text" value="{{system.trigger}}" placeholder="e.g. When a creature steps within 5ft" /></label>
          {{else}}
            <label><span>Action Type</span><select name="system.actionType">
              {{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq @root.system.actionType action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}
            </select></label>
          {{/if}}
          <label><span>Aura Action</span><input name="system.auraAction" type="checkbox" {{#if system.auraAction}}checked{{/if}} /></label>
          <label><span>Range</span><input name="system.range" type="number" value="{{system.range}}" min="0" /></label>
          <label><span>Recharge</span><input name="system.recharge" type="number" value="{{system.recharge}}" min="0" /></label>
          <label><span>Dice String</span><input name="system.dice" type="text" value="{{system.dice}}" placeholder="1d8" /></label>
          <label><span>Requires Check</span><input name="system.requiresCheck" type="checkbox" {{#if system.requiresCheck}}checked{{/if}} /></label>
          <label><span>Effect Type</span><select name="system.effectType">
            <option value="healing" {{#if (eq system.effectType "healing")}}selected{{/if}}>Healing</option>
            <option value="bludgeoning" {{#if (eq system.effectType "bludgeoning")}}selected{{/if}}>Bludgeoning Damage</option>
            <option value="piercing" {{#if (eq system.effectType "piercing")}}selected{{/if}}>Piercing Damage</option>
            <option value="slashing" {{#if (eq system.effectType "slashing")}}selected{{/if}}>Slashing Damage</option>
            <option value="acid" {{#if (eq system.effectType "acid")}}selected{{/if}}>Acid Damage</option>
            <option value="cold" {{#if (eq system.effectType "cold")}}selected{{/if}}>Cold Damage</option>
            <option value="fire" {{#if (eq system.effectType "fire")}}selected{{/if}}>Fire Damage</option>
            <option value="force" {{#if (eq system.effectType "force")}}selected{{/if}}>Force Damage</option>
            <option value="lightning" {{#if (eq system.effectType "lightning")}}selected{{/if}}>Lightning Damage</option>
            <option value="necrotic" {{#if (eq system.effectType "necrotic")}}selected{{/if}}>Necrotic Damage</option>
            <option value="poison" {{#if (eq system.effectType "poison")}}selected{{/if}}>Poison Damage</option>
            <option value="psychic" {{#if (eq system.effectType "psychic")}}selected{{/if}}>Psychic Damage</option>
            <option value="radiant" {{#if (eq system.effectType "radiant")}}selected{{/if}}>Radiant Damage</option>
            <option value="thunder" {{#if (eq system.effectType "thunder")}}selected{{/if}}>Thunder Damage</option>
          </select></label>
        </div>
      {{/if}}

      {{#if isEditMode}}
        {{#unless (or (eq item.type "spell") (eq item.type "gear") (eq item.type "weapon") (eq item.type "armor"))}}
          <div class="flex-row">
            <label>Description</label>
          </div>
          <textarea name="system.description">{{system.description}}</textarea>
        {{/unless}}
      {{/if}}

      {{#if (eq item.type "weaponTechnique")}}
        <div class="weapon-technique-panel">
          <label><span>Weapon Skill</span>
            <select name="system.skill" {{#unless isEditMode}}disabled{{/unless}}>
              {{#each @root.skillOptions as |skill|}}
                <option value="{{skill.key}}" {{#if (eq @root.system.skill skill.key)}}selected{{/if}}>{{skill.label}}</option>
              {{/each}}
            </select>
          </label>
          <label><span>Resource Cost to Begin</span>
            <input name="system.resourceCostToBegin" type="number" value="{{system.resourceCostToBegin}}" min="0" {{#unless isEditMode}}disabled{{/unless}} />
          </label>
          {{#each system.stages as |stage stageKey|}}
            <div class="weapon-technique-stage">
              <div class="weapon-technique-stage-header">
                <input class="weapon-technique-stage-name" name="system.stages.{{stageKey}}.name" type="text" value="{{stage.name}}" {{#unless @root.isEditMode}}disabled{{/unless}} />
                {{#unless (eq stageKey "3")}}
                  <label class="weapon-technique-advance-cost"><span>Resource Cost to Advance</span>
                    <input name="system.stages.{{stageKey}}.resourceCostToAdvance" type="number" value="{{stage.resourceCostToAdvance}}" min="0" {{#unless @root.isEditMode}}disabled{{/unless}} />
                  </label>
                {{/unless}}
              </div>
              <div class="weapon-technique-options">
                {{#each stage.options as |option optionKey|}}
                  <div class="weapon-technique-option">
                    <label><span>Option {{optionKey}} Name</span>
                      <input name="system.stages.{{stageKey}}.options.{{optionKey}}.name" type="text" value="{{option.name}}" {{#unless @root.isEditMode}}disabled{{/unless}} />
                    </label>
                    <label class="weapon-technique-option-description-label"><span>Description</span></label>
                    <textarea name="system.stages.{{stageKey}}.options.{{optionKey}}.description" {{#unless @root.isEditMode}}disabled{{/unless}}>{{option.description}}</textarea>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if (eq item.type "category")}}
        <div class="category-trait-panel">
          {{#each categoryTraitBuckets as |bucket|}}
            <div class="category-trait-displayer">
              <h3>{{bucket.label}}</h3>
              <div class="category-trait-drop-zone" data-drop-area="category-trait" data-bucket-key="{{bucket.key}}">
                {{#if bucket.entries.length}}
                  {{#each bucket.entries as |entry|}}
                    <div class="category-trait-row" data-bucket-key="{{bucket.key}}" data-entry-uuid="{{entry.uuid}}" title="{{#if @root.isEditMode}}Right-click to remove{{/if}}">
                      <button type="button" class="category-trait-open" data-entry-uuid="{{entry.uuid}}">{{entry.name}}</button>
                    </div>
                  {{/each}}
                {{else}}
                  <p class="category-trait-empty">Drag Trait items here.</p>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if (and isEditMode (or (eq item.type "trait") (eq item.type "npcAction")))}}
        <div class="item-area-editor">
          <label><span>Placeable Area</span><input name="system.areaOfEffect" type="checkbox" {{#if system.areaOfEffect}}checked{{/if}} /></label>
          {{#if system.areaOfEffect}}
            <div class="magic-item-area-fields">
              <label><span>Shape</span><select name="system.areaShape"><option value="cone" {{#if (eq system.areaShape "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq system.areaShape "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq system.areaShape "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq system.areaShape "radius")}}selected{{/if}}>Radius</option></select></label>
              <label><span>Area Color</span><input name="system.areaColor" type="color" value="{{system.areaColor}}" /></label>
              <label><span>Area Size</span><input name="system.areaSize" type="number" value="{{system.areaSize}}" min="1" /></label>
            </div>
            {{#if (eq system.areaShape "ray")}}
              <div class="magic-item-area-fields">
                <label><span>Ray Length</span><input name="system.areaRayLength" type="number" value="{{system.areaRayLength}}" min="1" /></label>
                <label><span>Ray Width</span><input name="system.areaRayWidth" type="number" value="{{system.areaRayWidth}}" min="1" /></label>
              </div>
            {{/if}}
          {{/if}}
        </div>
      {{/if}}

      {{#if isEditMode}}
        {{#if (eq item.type "talent")}}
          <div class="item-area-editor">
            <label><span>Placeable Area</span><input name="system.areaOfEffect" type="checkbox" {{#if system.areaOfEffect}}checked{{/if}} /></label>
            {{#if system.areaOfEffect}}
              <div class="magic-item-area-fields">
                <label><span>Shape</span><select name="system.areaShape"><option value="cone" {{#if (eq system.areaShape "cone")}}selected{{/if}}>Cone</option><option value="rect" {{#if (eq system.areaShape "rect")}}selected{{/if}}>Circle / Cube</option><option value="ray" {{#if (eq system.areaShape "ray")}}selected{{/if}}>Ray</option><option value="radius" {{#if (eq system.areaShape "radius")}}selected{{/if}}>Radius</option></select></label>
                <label><span>Area Color</span><input name="system.areaColor" type="color" value="{{system.areaColor}}" /></label>
                <label><span>Area Size</span><input name="system.areaSize" type="number" value="{{system.areaSize}}" min="1" /></label>
              </div>
              {{#if (eq system.areaShape "ray")}}
                <div class="magic-item-area-fields">
                  <label><span>Ray Length</span><input name="system.areaRayLength" type="number" value="{{system.areaRayLength}}" min="1" /></label>
                  <label><span>Ray Width</span><input name="system.areaRayWidth" type="number" value="{{system.areaRayWidth}}" min="1" /></label>
                </div>
              {{/if}}
            {{/if}}
          </div>
        {{/if}}
      {{/if}}

      {{#if (and isEditMode (eq item.type "armor"))}}
        <div class="armor-sheet-page active">
          <div class="currency-fields">
            <label><span>Gold</span><input name="system.gold" type="number" value="{{system.gold}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
            <label><span>Silver</span><input name="system.silver" type="number" value="{{system.silver}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
            <label><span>Copper</span><input name="system.copper" type="number" value="{{system.copper}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
          </div>
          <div class="armor-details-fields">
            <label><span>Type</span><select name="system.armorType" {{#unless isEditMode}}disabled{{/unless}}><option value="armor" {{#if (eq system.armorType "armor")}}selected{{/if}}>Armor</option><option value="shield" {{#if (eq system.armorType "shield")}}selected{{/if}}>Shield</option></select></label>
            <label><span>Tier</span><select name="system.tier" {{#unless isEditMode}}disabled{{/unless}}><option value="0" {{#if (eq system.tier "0")}}selected{{/if}}>0</option><option value="1" {{#if (eq system.tier "1")}}selected{{/if}}>1</option><option value="2" {{#if (eq system.tier "2")}}selected{{/if}}>2</option><option value="3" {{#if (eq system.tier "3")}}selected{{/if}}>3</option><option value="4" {{#if (eq system.tier "4")}}selected{{/if}}>4</option></select></label>
            <label><span>Defense Score</span><input name="system.defense" type="number" value="{{system.defense}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
            <label><span>Break Points</span><input name="system.breakPoints" type="number" value="{{system.breakPoints}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
          </div>
          <details class="armor-resistance-editor">
            <summary>Resistances Gained</summary>
            <div class="armor-resistance-grid">
              {{#each resistanceOptions as |resistance|}}
                <label><span>{{resistance.label}}</span><input name="system.resistances.{{resistance.value}}" type="number" value="{{lookup @root.system.resistances resistance.value}}" min="0" {{#unless @root.isEditMode}}disabled{{/unless}} /></label>
              {{/each}}
            </div>
          </details>
          <div class="flex-row"><label>Description</label></div>
          <textarea name="system.description" {{#unless isEditMode}}disabled{{/unless}}>{{system.description}}</textarea>
        </div>
        <div class="armor-sheet-page active">
          <h3>Active Resistance Effects</h3>
          {{#if armorResistanceEffects.length}}
            {{#each armorResistanceEffects as |effect|}}<div class="armor-effect-row"><span>{{effect.label}}</span><strong>+{{effect.value}}</strong></div>{{/each}}
          {{else}}
            <p>No active resistance effects.</p>
          {{/if}}
        </div>
      {{/if}}

      {{#if (and isEditMode (eq item.type "spell"))}}
        <div class="flex-row">
          <label>Tier</label>
          <select name="system.tier" {{#unless isEditMode}}disabled{{/unless}}>
            <option value="0" {{#if (eq system.tier "0")}}selected{{/if}}>0</option>
            <option value="1" {{#if (eq system.tier "1")}}selected{{/if}}>1</option>
            <option value="2" {{#if (eq system.tier "2")}}selected{{/if}}>2</option>
            <option value="3" {{#if (eq system.tier "3")}}selected{{/if}}>3</option>
          </select>
        </div>
        <div class="flex-row">
          <label>Magic Skill</label>
          <select name="system.magicSkill" {{#unless isEditMode}}disabled{{/unless}}>
            <option value="">None</option>
            {{#each @root.skillOptions as |skill|}}
              {{#if (or (eq skill.key "cosmic_magic") (eq skill.key "druidic_magic") (eq skill.key "elemental_magic") (eq skill.key "light_magic") (eq skill.key "shadow_magic"))}}
                <option value="{{skill.key}}" {{#if (eq @root.system.magicSkill skill.key)}}selected{{/if}}>{{skill.label}}</option>
              {{/if}}
            {{/each}}
          </select>
        </div>
        <div class="flex-row">
          <label>Action</label>
          <select name="system.actionType">
            {{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq @root.system.actionType action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}
          </select>
        </div>
        <div class="flex-row">
          <label>Resource Cost</label>
          <input name="system.resourceCost" type="number" value="{{system.resourceCost}}" min="0" {{#unless isEditMode}}disabled{{/unless}} />
        </div>
        <div class="flex-row">
          <div class="flex-row" style="gap: 10px; flex: 1;">
            <label>Empowerment Cost</label>
            <input name="system.empowermentCost" type="number" value="{{system.empowermentCost}}" min="0" {{#unless isEditMode}}disabled{{/unless}} />
          </div>
          <div class="flex-row" style="gap: 10px; flex: 1;">
            <label>Empowerment Dice</label>
            <input name="system.empowermentDice" type="text" value="{{system.empowermentDice}}" placeholder="1d6" {{#unless isEditMode}}disabled{{/unless}} />
          </div>
        </div>
        <div class="spell-dice-fields">
          <label><span>Dice Value</span><input name="system.damageHealing" type="text" value="{{system.damageHealing}}" placeholder="1d8" {{#unless isEditMode}}disabled{{/unless}} /></label>
          <label><span>Effect Type</span><select name="system.damageType" {{#unless isEditMode}}disabled{{/unless}}>
            <option value="healing" {{#if (eq system.damageType "healing")}}selected{{/if}}>Healing</option>
            <option value="bludgeoning" {{#if (eq system.damageType "bludgeoning")}}selected{{/if}}>Bludgeoning Damage</option>
            <option value="piercing" {{#if (eq system.damageType "piercing")}}selected{{/if}}>Piercing Damage</option>
            <option value="slashing" {{#if (eq system.damageType "slashing")}}selected{{/if}}>Slashing Damage</option>
            <option value="acid" {{#if (eq system.damageType "acid")}}selected{{/if}}>Acid Damage</option>
            <option value="cold" {{#if (eq system.damageType "cold")}}selected{{/if}}>Cold Damage</option>
            <option value="fire" {{#if (eq system.damageType "fire")}}selected{{/if}}>Fire Damage</option>
            <option value="force" {{#if (eq system.damageType "force")}}selected{{/if}}>Force Damage</option>
            <option value="lightning" {{#if (eq system.damageType "lightning")}}selected{{/if}}>Lightning Damage</option>
            <option value="necrotic" {{#if (eq system.damageType "necrotic")}}selected{{/if}}>Necrotic Damage</option>
            <option value="poison" {{#if (eq system.damageType "poison")}}selected{{/if}}>Poison Damage</option>
            <option value="psychic" {{#if (eq system.damageType "psychic")}}selected{{/if}}>Psychic Damage</option>
            <option value="radiant" {{#if (eq system.damageType "radiant")}}selected{{/if}}>Radiant Damage</option>
            <option value="thunder" {{#if (eq system.damageType "thunder")}}selected{{/if}}>Thunder Damage</option>
          </select></label>
          {{#if (eq system.damageType "healing")}}
            <label><span>Add to Healing Tracker</span><input name="system.trackHealing" type="checkbox" {{#if system.trackHealing}}checked{{/if}} {{#unless isEditMode}}disabled{{/unless}} /></label>
          {{/if}}
          <label><span>Requires Concentration</span><input name="system.concentration" type="checkbox" {{#if system.concentration}}checked{{/if}} {{#unless isEditMode}}disabled{{/unless}} /></label>
        </div>
        <div class="flex-row">
          <label>Range in Squares</label>
          <input name="system.range" type="number" value="{{system.range}}" min="0" {{#unless isEditMode}}disabled{{/unless}} />
        </div>
      {{else}}
        {{#if isEditMode}}
        {{#unless (or (eq item.type "profession") (eq item.type "race") (eq item.type "talent") (eq item.type "weapon") (eq item.type "armor") (eq item.type "trait") (eq item.type "npcAction") (eq item.type "category") (eq item.type "weaponTechnique"))}}
          {{#if (eq item.type "gear")}}
            <div class="currency-fields">
              <label><span>Gold</span><input name="system.gold" type="number" value="{{system.gold}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
              <label><span>Silver</span><input name="system.silver" type="number" value="{{system.silver}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
              <label><span>Copper</span><input name="system.copper" type="number" value="{{system.copper}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label>
            </div>
            <div class="currency-fields">
              <label><span>Category</span><select name="system.category" {{#unless isEditMode}}disabled{{/unless}}><option value="consumable" {{#if (eq system.category "consumable")}}selected{{/if}}>Consumable</option><option value="tool" {{#if (eq system.category "tool")}}selected{{/if}}>Tool</option><option value="magic_item" {{#if (eq system.category "magic_item")}}selected{{/if}}>Magic Item</option><option value="misc" {{#if (eq system.category "misc")}}selected{{/if}}>Misc</option></select></label>
              <label><span>Tier</span><select name="system.tier" {{#unless isEditMode}}disabled{{/unless}}><option value="0" {{#if (eq system.tier "0")}}selected{{/if}}>0</option><option value="1" {{#if (eq system.tier "1")}}selected{{/if}}>1</option><option value="2" {{#if (eq system.tier "2")}}selected{{/if}}>2</option><option value="3" {{#if (eq system.tier "3")}}selected{{/if}}>3</option><option value="4" {{#if (eq system.tier "4")}}selected{{/if}}>4</option></select></label>
              <label><span>Action</span><select name="system.actionType">{{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq @root.system.actionType action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}</select></label>
            </div>
            <div class="profession-detail-fields"><label><span>Quantity</span><input name="system.quantity" type="number" value="{{system.quantity}}" min="0" {{#unless isEditMode}}disabled{{/unless}} /></label></div>
          {{else}}
            <div class="flex-row"><label>Cost</label><input name="system.cost" type="number" value="{{system.cost}}" /></div>
            <div class="flex-row"><label>Quantity</label><input name="system.quantity" type="number" value="{{system.quantity}}" /></div>
          {{/if}}
          {{#if (eq item.type "gear")}}
          {{else}}
            <div class="flex-row"><label>Attribute</label><input name="system.attribute" type="text" value="{{system.attribute}}" /></div>
          {{/if}}
        {{/unless}}
        {{/if}}

        {{#if (and isEditMode (eq item.type "gear"))}}
          {{#if (eq system.category "consumable")}}
            <div class="consumable-fields">
              <label><span>Ammunition</span><input name="system.ammunition" type="checkbox" {{#if system.ammunition}}checked{{/if}} {{#unless isEditMode}}disabled{{/unless}} /></label>
              <label><span>Dice Value</span><input name="system.consumableDice" type="text" value="{{system.consumableDice}}" placeholder="1d6" {{#unless isEditMode}}disabled{{/unless}} /></label>
              <label><span>Effect</span><select name="system.consumableEffect" {{#unless isEditMode}}disabled{{/unless}}><option value="damage" {{#if (eq system.consumableEffect "damage")}}selected{{/if}}>Damage</option><option value="healing" {{#if (eq system.consumableEffect "healing")}}selected{{/if}}>Healing</option></select></label>
            {{#if (eq system.consumableEffect "damage")}}
              <label><span>Damage Type</span><select name="system.damageType" {{#unless isEditMode}}disabled{{/unless}}>
                  <option value="bludgeoning" {{#if (eq system.damageType "bludgeoning")}}selected{{/if}}>Bludgeoning</option>
                  <option value="piercing" {{#if (eq system.damageType "piercing")}}selected{{/if}}>Piercing</option>
                  <option value="slashing" {{#if (eq system.damageType "slashing")}}selected{{/if}}>Slashing</option>
