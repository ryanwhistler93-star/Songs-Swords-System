              </div>
              <div class="feature-level-editor profession-feature-level-editor">
                <label><span>Level 9</span><input name="system.features.9.title" type="text" value="{{lookup (lookup system.features "9") "title"}}" placeholder="Feature Title" /></label>
                <label><span>Action</span><select name="system.features.9.actionType">{{#each actionTypeOptions as |action|}}<option value="{{action.value}}" {{#if (eq (lookup (lookup @root.system.features "9") "actionType") action.value)}}selected{{/if}}>{{action.label}}</option>{{/each}}</select></label>
                <textarea name="system.features.9.text" placeholder="Feature description">{{lookup (lookup system.features "9") "text"}}</textarea>
